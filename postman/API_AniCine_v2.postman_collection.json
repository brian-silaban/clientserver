{
  "info": {
    "name": "AniCine v2.0 REST API (PLMKB502 Portfolio)",
    "description": "Koleksi pengujian lengkap REST API v1 AniCine (Port 8083): Auth JWT, Katalog Publik, Jadwal & Peta Kursi Bioskop Anime, Booking ACID + Locking, Watchlist RLS, Admin CRUD, Audit Log Viewer, dan Backup & Verifikasi Database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083/api/v1" },
    { "key": "memberToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "backupFile", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth & Profil",
      "item": [
        {
          "name": "Login Member Demo",
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json(); if (res.data?.token?.access_token) pm.collectionVariables.set('memberToken', res.data.token.access_token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"user@anicine.local\",\n  \"password\": \"User#AniCine2026\"\n}" }
          }
        },
        {
          "name": "Login Admin Demo",
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json(); if (res.data?.token?.access_token) pm.collectionVariables.set('adminToken', res.data.token.access_token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"admin@anicine.local\",\n  \"password\": \"Admin#AniCine2026\"\n}" }
          }
        },
        {
          "name": "Register Akun Baru",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"penonton_medan\",\n  \"email\": \"penonton@example.com\",\n  \"password\": \"Rahasia#2026\",\n  \"gender\": \"Male\",\n  \"location\": \"Medan\",\n  \"birth_date\": \"2003-04-10\"\n}" }
          }
        },
        {
          "name": "Profil Aktif (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Publik (Tanpa Login)",
      "item": [
        { "name": "Katalog Anime (Paginasi & Filter)", "request": { "method": "GET", "url": "{{baseUrl}}/anime?page=1&per_page=12&sort=score" } },
        { "name": "Metadata Filter Katalog", "request": { "method": "GET", "url": "{{baseUrl}}/anime/meta" } },
        { "name": "Anime Sedang & Akan Tayang di Bioskop Medan", "request": { "method": "GET", "url": "{{baseUrl}}/anime/theatrical" } },
        { "name": "Detail Anime (Kimi no Na wa. #32281)", "request": { "method": "GET", "url": "{{baseUrl}}/anime/32281" } },
        { "name": "Status Koneksi Bioskop", "request": { "method": "GET", "url": "{{baseUrl}}/cinema/status" } },
        { "name": "Jadwal Tayang Anime Medan", "request": { "method": "GET", "url": "{{baseUrl}}/cinema/showtimes" } },
        { "name": "Pratinjau Denah Kursi Showtime #21", "request": { "method": "GET", "url": "{{baseUrl}}/cinema/showtimes/21/seats" } }
      ]
    },
    {
      "name": "3. Member (Booking ACID & Watchlist RLS)",
      "item": [
        {
          "name": "Pesan Tiket & Pilih Kursi (ACID + Locking)",
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json(); if (res.data?.booking_id) pm.collectionVariables.set('bookingId', res.data.booking_id);"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": { "mode": "raw", "raw": "{\n  \"showtime_id\": 21,\n  \"seat_ids\": [1, 2]\n}" }
          }
        },
        {
          "name": "Riwayat Tiket Saya (RLS)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Simulasi Bayar Tiket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/pay"
          }
        },
        {
          "name": "Batalkan Pesanan PENDING",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel"
          }
        },
        {
          "name": "Lihat Watchlist & Statistik (v_user_stats + fn_user_status_summary)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/watchlist"
          }
        },
        {
          "name": "Simpan / Update Watchlist (Naruto #20)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": "{{baseUrl}}/watchlist/20",
            "body": { "mode": "raw", "raw": "{\n  \"status_id\": 1,\n  \"watched_episodes\": 50,\n  \"score\": 9\n}" }
          }
        }
      ]
    },
    {
      "name": "4. Admin (RBAC, Audit Log & Backup API)",
      "item": [
        { "name": "Dashboard Admin", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/dashboard" } },
        { "name": "Daftar Pemetaan Anime Bioskop", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/theatrical" } },
        { "name": "Daftar Seluruh Booking (Admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/bookings" } },
        { "name": "Daftar Akun User (Admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/users" } },
        { "name": "Audit Log Viewer", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/audit-logs?per_page=20" } },
        {
          "name": "Buat Backup Database (pg_dump -Fc)",
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json(); if (res.data?.file) pm.collectionVariables.set('backupFile', res.data.file);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/backups" }
        },
        { "name": "Daftar Arsip Backup", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/backups" } },
        { "name": "Verifikasi Integritas Backup", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/backups/{{backupFile}}/verify" } }
      ]
    }
  ]
}
