{
  "info": {
    "name": "API AniCine (Integrasi Informasi Anime & Jadwal Bioskop Medan)",
    "description": "Koleksi Postman resmi REST API AniCine (Tanpa Frontend): Mengintegrasikan Layanan Katalog Anime (Brian - db_anitrack) & Layanan Informasi Jadwal Bioskop Medan (Sat - db_bioskop) menggunakan CodeIgniter 4 + PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    }
  ],
  "item": [
    {
      "name": "1. Anime Service & Mashup (Brian)",
      "item": [
        {
          "name": "1.1 GET Anime Theatrical (Tayang di Bioskop + Jadwal)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/anime/theatrical"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Total 5 anime tayang di bioskop', () => pm.expect(res.total).to.be.at.least(5));",
                  "pm.test('Memiliki cinema_movie_id & jadwal bioskop', () => {",
                  "  pm.expect(res.data[0]).to.have.property('cinema_movie_id');",
                  "  pm.expect(res.data[0]).to.have.property('cinema_showtimes');",
                  "  pm.expect(res.data[0].cinema_showtimes).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 GET Detail Anime Movie (Kimi no Na wa - Auto-Embed Jadwal Bioskop)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/anime/32281"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Judul Kimi no Na wa.', () => pm.expect(res.data.title).to.eql('Kimi no Na wa.'));",
                  "pm.test('Is Theatrical bernilai true', () => pm.expect(res.data.is_theatrical).to.be.true);",
                  "pm.test('Ada data genre & studio dari db_anitrack', () => {",
                  "  pm.expect(res.data).to.have.property('genres');",
                  "  pm.expect(res.data).to.have.property('studios');",
                  "});",
                  "pm.test('Otomatis menyertakan jadwal bioskop Medan dari Service Sat', () => {",
                  "  pm.expect(res.data.cinema_showtimes).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(res.data.cinema_showtimes[0]).to.have.property('cinema_name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 GET Detail Anime TV Series (Naruto - Tidak Tayang di Bioskop)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/anime/20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Judul Naruto', () => pm.expect(res.data.title).to.eql('Naruto'));",
                  "pm.test('Is Theatrical bernilai false & cinema_showtimes kosong', () => {",
                  "  pm.expect(res.data.is_theatrical).to.be.false;",
                  "  pm.expect(res.data.cinema_showtimes).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 GET Semua Anime (Paginasi & Pencarian)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/anime?page=1&per_page=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Memiliki informasi paginasi', () => pm.expect(pm.response.json()).to.have.property('pager'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 GET Anime Berdasarkan Tahun Rilis",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/anime/tahun/2016"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Cinema Information Service (Sat)",
      "item": [
        {
          "name": "2.1 GET Status Integrasi Bioskop",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinema/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Target database db_bioskop', () => pm.expect(res.data.database_target).to.eql('db_bioskop'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 GET Semua Film Bioskop",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinema/movies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 GET Hanya Film Anime di Bioskop",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinema/movies?anime_only=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Semua film bertanda is_anime = true', () => res.data.forEach(m => pm.expect(m.is_anime).to.be.true));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 GET Detail Film Bioskop (Kimi no Na wa)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinema/movies/372058"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Matched Anime ID adalah 32281', () => pm.expect(pm.response.json().data.matched_anime_id).to.eql(32281));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 GET Semua Jadwal Tayang Bioskop Medan",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinema/showtimes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 GET Jadwal Tayang Khusus Kimi no Na wa",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinema/showtimes?movie_id=372058"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Memiliki informasi studio, harga, dan sisa kursi', () => {",
                  "  pm.expect(res.data[0]).to.have.property('cinema_name');",
                  "  pm.expect(res.data[0]).to.have.property('ticket_price');",
                  "  pm.expect(res.data[0]).to.have.property('seats_available');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.7 GET Daftar Studio & Bioskop di Medan",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cinema/studios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
